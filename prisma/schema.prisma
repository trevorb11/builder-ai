// Builder AI Platform - Database Schema
// Comprehensive schema for homebuilder AI tools

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// CORE ENTITIES
// ==========================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  role          String    @default("user") // admin, builder_admin, sales_agent, marketing, realtor
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  organizationId String?

  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  salesSessions SalesTrainingSession[]
  contentDrafts MarketingContent[]
  researchReports DeepResearchReport[]

  @@index([organizationId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// ORGANIZATION (BUILDER COMPANY)
// ==========================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logo        String?
  website     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  brandVoice  String?  // Brand voice guidelines for AI content generation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  communities        Community[]
  floorplans         Floorplan[]
  leads              Lead[]
  competitors        Competitor[]
  crmIntegrations    CRMIntegration[]
  chatbotConfigs     ChatbotConfig[]
  marketingContent   MarketingContent[]
  faqSections        FAQSection[]
  realtorPortal      RealtorPortalConfig?
  aiSearchMonitor    AISearchMonitor[]
  competitiveReports CompetitiveReport[]

  // Deep Research relations
  deepResearchReports    DeepResearchReport[]
  digitalFootprintConfig DigitalFootprintConfig?
  contentStrategyConfig  ContentStrategyConfig?
  contentTopics          ContentTopic[]

  // Onboarding & Knowledge relations
  onboarding         BuilderOnboarding?
  knowledge          BuilderKnowledge[]

  @@index([slug])
}

// ==========================================
// COMMUNITIES & FLOORPLANS
// ==========================================

model Community {
  id              String   @id @default(cuid())
  name            String
  slug            String
  description     String?
  address         String?
  city            String?
  state           String?
  zipCode         String?
  latitude        Float?
  longitude       Float?
  status          String   @default("active") // active, coming_soon, sold_out
  amenities       String?  // JSON array of amenities
  schools         String?  // JSON array of nearby schools
  hoa             String?  // HOA information
  hoaFee          Float?
  startingPrice   Float?
  priceRange      String?
  estimatedMoveIn String?
  images          String?  // JSON array of image URLs
  virtualTourUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  floorplans  Floorplan[]
  inventory   InventoryHome[]
  leads       Lead[]
  faqs        FAQSection[]
  incentives  Incentive[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([status])
}

model Floorplan {
  id              String   @id @default(cuid())
  name            String
  slug            String
  description     String?
  bedrooms        Int
  bathrooms       Float
  halfBaths       Int      @default(0)
  squareFeet      Int
  stories         Int      @default(1)
  garageSpaces    Int      @default(2)
  basePrice       Float
  features        String?  // JSON array of features
  images          String?  // JSON array of image URLs
  floorplanPdf    String?
  virtualTourUrl  String?
  elevations      String?  // JSON array of elevation options
  structuralOptions String? // JSON array of structural options
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  community   Community? @relation(fields: [communityId], references: [id])
  communityId String?

  inventory InventoryHome[]
  leads     Lead[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([communityId])
  @@index([bedrooms, bathrooms])
  @@index([squareFeet])
  @@index([basePrice])
}

model InventoryHome {
  id             String   @id @default(cuid())
  lot            String?
  block          String?
  address        String?
  price          Float
  status         String   @default("available") // available, pending, sold, model
  moveInDate     String?
  completionDate String?
  features       String?  // JSON array of included features/upgrades
  images         String?  // JSON array of images
  mlsNumber      String?
  virtualTourUrl String?
  specialNotes   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String

  floorplan   Floorplan @relation(fields: [floorplanId], references: [id])
  floorplanId String

  @@index([communityId])
  @@index([floorplanId])
  @@index([status])
}

model Incentive {
  id          String   @id @default(cuid())
  title       String
  description String
  type        String   // financing, closing_costs, upgrade, price_reduction, realtor_bonus
  value       String?  // e.g., "$10,000", "3%", "Free upgrades"
  terms       String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String

  @@index([communityId])
  @@index([isActive])
}

// ==========================================
// LEADS & CONVERSATIONS (Website AI Assistant)
// ==========================================

model Lead {
  id              String   @id @default(cuid())
  email           String?
  phone           String?
  firstName       String?
  lastName        String?
  source          String?  // website_chat, realtor_portal, direct
  status          String   @default("new") // new, contacted, qualified, nurturing, closed_won, closed_lost
  budget          String?
  timeline        String?
  notes           String?
  interestedIn    String?  // JSON array of community/floorplan interests
  score           Int      @default(0) // Lead score 0-100
  crmSynced       Boolean  @default(false)
  crmId           String?  // External CRM ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  community   Community? @relation(fields: [communityId], references: [id])
  communityId String?

  floorplan   Floorplan? @relation(fields: [floorplanId], references: [id])
  floorplanId String?

  conversations Conversation[]

  @@index([organizationId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Conversation {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  source       String   @default("website") // website, realtor_portal, sales_trainer
  status       String   @default("active") // active, closed
  summary      String?
  sentiment    String?  // positive, neutral, negative
  intentScore  Int?     // 0-100 how likely to buy
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lead   Lead?   @relation(fields: [leadId], references: [id])
  leadId String?

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  messages Message[]

  @@index([leadId])
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
}

model Message {
  id        String   @id @default(cuid())
  role      String   // user, assistant, system
  content   String
  metadata  String?  // JSON for additional data (matched floorplans, etc.)
  createdAt DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId])
  @@index([createdAt])
}

// ==========================================
// CHATBOT CONFIGURATION
// ==========================================

model ChatbotConfig {
  id               String   @id @default(cuid())
  name             String   @default("Website Assistant")
  welcomeMessage   String   @default("Hi! I'm here to help you find your perfect new home. How can I assist you today?")
  personality      String?  // JSON for personality traits
  primaryColor     String   @default("#2563eb")
  accentColor      String   @default("#3b82f6")
  position         String   @default("bottom-right")
  collectEmail     Boolean  @default(true)
  collectPhone     Boolean  @default(true)
  collectName      Boolean  @default(true)
  autoOpen         Boolean  @default(false)
  autoOpenDelay    Int      @default(30) // seconds
  isActive         Boolean  @default(true)
  embedCode        String?
  customCss        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique
}

// ==========================================
// CRM INTEGRATIONS
// ==========================================

model CRMIntegration {
  id           String   @id @default(cuid())
  provider     String   // hubspot, salesforce, gohighlevel
  name         String
  isActive     Boolean  @default(true)
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  apiKey       String?
  instanceUrl  String?
  portalId     String?
  settings     String?  // JSON for provider-specific settings
  lastSyncAt   DateTime?
  syncStatus   String   @default("pending") // pending, syncing, success, error
  syncError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  webhooks CRMWebhook[]
  syncLogs CRMSyncLog[]

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model CRMWebhook {
  id        String   @id @default(cuid())
  event     String   // lead.created, lead.updated, conversation.completed
  url       String
  isActive  Boolean  @default(true)
  secret    String?
  createdAt DateTime @default(now())

  integration   CRMIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  integrationId String

  @@index([integrationId])
}

model CRMSyncLog {
  id        String   @id @default(cuid())
  action    String   // create, update, sync
  entity    String   // lead, contact, conversation
  entityId  String
  status    String   // success, error
  request   String?  // JSON request payload
  response  String?  // JSON response
  error     String?
  createdAt DateTime @default(now())

  integration   CRMIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  integrationId String

  @@index([integrationId])
  @@index([createdAt])
}

// ==========================================
// MARKETING ASSISTANT
// ==========================================

model MarketingContent {
  id           String   @id @default(cuid())
  title        String
  type         String   // social_post, email, blog, listing, ad_copy, realtor_email
  platform     String?  // facebook, instagram, linkedin, email, website
  content      String
  status       String   @default("draft") // draft, approved, published, archived
  scheduledFor DateTime?
  publishedAt  DateTime?
  metadata     String?  // JSON for platform-specific data
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// AI SEARCH OPTIMIZATION
// ==========================================

model FAQSection {
  id        String   @id @default(cuid())
  category  String   // general, pricing, financing, timeline, features, community
  question  String
  answer    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  community   Community? @relation(fields: [communityId], references: [id])
  communityId String?

  @@index([organizationId])
  @@index([communityId])
  @@index([category])
}

model AISearchMonitor {
  id          String   @id @default(cuid())
  platform    String   // chatgpt, gemini, perplexity, bing_copilot
  query       String
  response    String
  mentions    Boolean  @default(false)
  sentiment   String?  // positive, neutral, negative
  competitors String?  // JSON array of competitors mentioned
  checkedAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId])
  @@index([platform])
  @@index([checkedAt])
}

// ==========================================
// COMPETITIVE INTELLIGENCE
// ==========================================

model Competitor {
  id          String   @id @default(cuid())
  name        String
  website     String?
  description String?
  markets     String?  // JSON array of markets/cities
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  communities  CompetitorCommunity[]
  reports      CompetitiveReport[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model CompetitorCommunity {
  id            String   @id @default(cuid())
  name          String
  city          String?
  state         String?
  priceRange    String?
  startingPrice Float?
  amenities     String?  // JSON array
  schoolInfo    String?
  hoaFee        Float?
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())

  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  competitorId String

  floorplans CompetitorFloorplan[]

  @@index([competitorId])
}

model CompetitorFloorplan {
  id          String   @id @default(cuid())
  name        String
  bedrooms    Int?
  bathrooms   Float?
  squareFeet  Int?
  price       Float?
  features    String?  // JSON array
  notes       String?
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())

  community   CompetitorCommunity @relation(fields: [communityId], references: [id], onDelete: Cascade)
  communityId String

  @@index([communityId])
}

model CompetitiveReport {
  id            String   @id @default(cuid())
  title         String
  reportType    String   // market_overview, pricing_analysis, feature_comparison, incentive_analysis
  content       String   // JSON structured report content
  summary       String?
  insights      String?  // JSON array of key insights
  generatedAt   DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  competitor   Competitor? @relation(fields: [competitorId], references: [id])
  competitorId String?

  @@index([organizationId])
  @@index([competitorId])
  @@index([reportType])
}

// ==========================================
// SALES TRAINER AI
// ==========================================

model SalesTrainingSession {
  id          String   @id @default(cuid())
  scenario    String   // objection_handling, product_knowledge, closing, discovery
  difficulty  String   @default("medium") // easy, medium, hard
  buyerPersona String?  // JSON describing the simulated buyer
  status      String   @default("active") // active, completed, reviewed
  score       Int?     // 0-100 performance score
  feedback    String?  // AI-generated feedback
  duration    Int?     // seconds
  createdAt   DateTime @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  messages SalesTrainingMessage[]
  metrics  SalesTrainingMetrics?

  @@index([userId])
  @@index([scenario])
  @@index([createdAt])
}

model SalesTrainingMessage {
  id        String   @id @default(cuid())
  role      String   // agent, buyer, coach
  content   String
  feedback  String?  // Real-time coaching feedback
  score     Int?     // Message-level score
  createdAt DateTime @default(now())

  session   SalesTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String

  @@index([sessionId])
}

model SalesTrainingMetrics {
  id                String @id @default(cuid())
  objectionHandling Int?   // 0-100
  productKnowledge  Int?   // 0-100
  rapport           Int?   // 0-100
  closingSkills     Int?   // 0-100
  listeningSkills   Int?   // 0-100
  overallScore      Int?   // 0-100

  session   SalesTrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String               @unique
}

// ==========================================
// REALTOR PORTAL
// ==========================================

model RealtorPortalConfig {
  id               String   @id @default(cuid())
  isActive         Boolean  @default(true)
  portalUrl        String?
  welcomeMessage   String?
  showPricing      Boolean  @default(true)
  showIncentives   Boolean  @default(true)
  showInventory    Boolean  @default(true)
  showFloorplans   Boolean  @default(true)
  requireLogin     Boolean  @default(false)
  coopCommission   String?  // Default co-op commission info
  contactEmail     String?
  contactPhone     String?
  customBranding   String?  // JSON for branding options
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  realtors RealtorAccess[]
}

model RealtorAccess {
  id           String   @id @default(cuid())
  email        String
  name         String?
  company      String?
  phone        String?
  licenseNumber String?
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  portal   RealtorPortalConfig @relation(fields: [portalId], references: [id], onDelete: Cascade)
  portalId String

  @@unique([portalId, email])
  @@index([portalId])
  @@index([email])
}

// ==========================================
// DEEP RESEARCH
// ==========================================

model DeepResearchReport {
  id              String   @id @default(cuid())
  type            String   // digital_footprint, competitor_research, content_strategy, market_analysis
  title           String
  status          String   @default("pending") // pending, in_progress, completed, failed
  summary         String?
  findings        String?  // JSON array of findings
  sources         String?  // JSON array of sources
  recommendations String?  // JSON array of recommendations
  rawResponse     String?  // Full AI response
  metadata        String?  // JSON for type-specific data
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model DigitalFootprintConfig {
  id               String   @id @default(cuid())
  websiteUrl       String?
  facebookUrl      String?
  instagramUrl     String?
  linkedinUrl      String?
  youtubeUrl       String?
  tiktokUrl        String?
  pinterestUrl     String?
  googleBusinessUrl String?
  yelpUrl          String?
  bbbUrl           String?
  houzzUrl         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique
}

model ContentStrategyConfig {
  id             String   @id @default(cuid())
  markets        String?  // JSON array of target markets
  targetAudience String?
  brandVoice     String?
  contentGoals   String?  // JSON array of goals
  competitors    String?  // JSON array of competitor names to monitor
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique
}

model ContentTopic {
  id          String   @id @default(cuid())
  title       String
  category    String   // trending, local, education, seo, social, ai_search
  description String?
  keywords    String?  // JSON array of related keywords
  priority    String   @default("medium") // high, medium, low
  status      String   @default("suggested") // suggested, planned, in_progress, published, archived
  searchVolume Int?
  competition  String?  // low, medium, high
  notes       String?
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  @@index([organizationId])
  @@index([category])
  @@index([status])
  @@index([priority])
}

// ==========================================
// BUILDER ONBOARDING & KNOWLEDGE BASE
// ==========================================

// Tracks onboarding progress and completion
model BuilderOnboarding {
  id              String    @id @default(cuid())
  status          String    @default("in_progress") // in_progress, completed
  currentStep     Int       @default(1)
  totalSteps      Int       @default(10)
  completedSteps  String?   // JSON array of completed step numbers
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String       @unique

  // Related onboarding sections
  companyProfile    OnboardingCompanyProfile?
  salesConfig       OnboardingSalesConfig?
  techAccess        OnboardingTechAccess?
  contentPrefs      OnboardingContentPrefs?
  launchConfig      OnboardingLaunchConfig?
}

// Extended company profile from onboarding
model OnboardingCompanyProfile {
  id                String   @id @default(cuid())
  tagline           String?
  missionStatement  String?
  yearEstablished   Int?
  employeeCount     String?  // e.g., "10-50", "50-100"
  homesBuiltPerYear String?  // e.g., "50-100", "100-500"
  targetBuyers      String?  // JSON array: ["first-time", "move-up", "luxury", "active-adult"]
  priceRanges       String?  // JSON array of price range objects
  markets           String?  // JSON array of market/region names
  differentiators   String?  // What makes them unique - text description
  valueProposition  String?  // Core value proposition
  brandVoice        String?  // professional, friendly, luxury, approachable, etc.
  brandPersonality  String?  // JSON array of personality traits
  competitiveAdvantages String? // JSON array of advantages over competitors
  awards            String?  // JSON array of awards/recognitions
  certifications    String?  // JSON array: ["Energy Star", "LEED", etc.]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  onboarding        BuilderOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  onboardingId      String   @unique
}

// Sales training configuration
model OnboardingSalesConfig {
  id                    String   @id @default(cuid())
  teamSize              Int?
  salesAgents           String?  // JSON array of {name, email, role}
  commonObjections      String?  // JSON array of common objections they face
  competitorObjections  String?  // JSON array of competitor-specific objections
  uniqueSellingPoints   String?  // JSON array of USPs to emphasize
  pricingStrategy       String?  // How they discuss pricing
  negotiationBoundaries String?  // What agents can/cannot negotiate
  closingTechniques     String?  // JSON array of preferred closing approaches
  existingMaterials     String?  // Description of existing training materials
  focusAreas            String?  // JSON array of areas to focus training on
  buyerPersonas         String?  // JSON array of buyer persona objects
  salesProcess          String?  // Description of their sales process
  averageSalesCycle     String?  // e.g., "30-60 days"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  onboarding            BuilderOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  onboardingId          String   @unique
}

// Technical access and website info
model OnboardingTechAccess {
  id                  String   @id @default(cuid())
  websiteUrl          String?
  websitePlatform     String?  // wordpress, custom, squarespace, etc.
  hasAdminAccess      Boolean  @default(false)
  adminAccessNotes    String?
  googleAnalyticsId   String?
  gtmContainerId      String?
  hasDnsAccess        Boolean  @default(false)
  dnsProvider         String?
  hostingProvider     String?
  currentChatWidget   String?  // Existing chat tool if any
  otherMarketingTools String?  // JSON array of tools they use
  apiAccess           String?  // JSON array of available API integrations
  sslCertificate      Boolean  @default(false)
  mobileOptimized     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  onboarding          BuilderOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  onboardingId        String   @unique
}

// Content and marketing preferences
model OnboardingContentPrefs {
  id                    String   @id @default(cuid())
  // Social media
  facebookHandle        String?
  instagramHandle       String?
  linkedinHandle        String?
  youtubeChannel        String?
  tiktokHandle          String?
  pinterestHandle       String?
  // Email marketing
  emailPlatform         String?  // mailchimp, constant contact, hubspot, etc.
  hasEmailIntegration   Boolean  @default(false)
  emailListSize         String?  // approximate size
  emailFrequency        String?  // how often they send emails
  // Content preferences
  contentTone           String?  // professional, friendly, luxury, casual
  contentTopics         String?  // JSON array of preferred topics
  avoidTopics           String?  // JSON array of topics to avoid
  existingContent       String?  // Description of existing content assets
  photoLibrary          Boolean  @default(false)
  videoAssets           Boolean  @default(false)
  virtualTours          Boolean  @default(false)
  // Blog/SEO
  hasBlog               Boolean  @default(false)
  blogUrl               String?
  seoFocus              String?  // JSON array of SEO focus keywords
  // Advertising
  runsPaidAds           Boolean  @default(false)
  adPlatforms           String?  // JSON array: ["Google Ads", "Facebook", "Instagram"]
  monthlyAdBudget       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  onboarding            BuilderOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  onboardingId          String   @unique
}

// Launch and approval configuration
model OnboardingLaunchConfig {
  id                    String    @id @default(cuid())
  // Primary contacts
  primaryContactName    String?
  primaryContactEmail   String?
  primaryContactPhone   String?
  primaryContactRole    String?
  // Approval workflow
  requiresApproval      Boolean   @default(true)
  approverName          String?
  approverEmail         String?
  approverPhone         String?
  approvalProcess       String?   // Description of approval process
  // Launch timeline
  targetLaunchDate      DateTime?
  launchPriorities      String?   // JSON array of priority items for launch
  phasedRollout         Boolean   @default(false)
  phaseDetails          String?   // JSON array of phases if phased rollout
  // Support
  preferredMeetingTimes String?   // JSON array of preferred times
  timezone              String?
  communicationPrefs    String?   // email, phone, slack, etc.
  additionalNotes       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  onboarding            BuilderOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  onboardingId          String    @unique
}

// Flexible key-value knowledge storage for AI context
model BuilderKnowledge {
  id              String   @id @default(cuid())
  category        String   // company, community, floorplan, pricing, competitor, sales, marketing, faq
  key             String   // Specific knowledge key
  value           String   // The knowledge/answer value
  metadata        String?  // JSON for additional structured data
  isActive        Boolean  @default(true)
  priority        Int      @default(0) // Higher priority = more important context
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String

  @@unique([organizationId, category, key])
  @@index([organizationId])
  @@index([category])
  @@index([isActive])
}
